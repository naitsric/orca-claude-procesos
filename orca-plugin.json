{
  "manifestVersion": 2,
  "id": "claude-procesos",
  "name": "Claude Processes",
  "version": "0.5.0",
  "description": "Monitor for Claude Code sessions, the processes they start and the ones left orphaned, with a verdict on which to close. In English and Spanish.",
  "icon": "design/icon-256.png",
  "author": {
    "name": "naitsric",
    "url": "https://github.com/naitsric"
  },
  "repository": "https://github.com/naitsric/orca-claude-procesos",
  "homepage": "https://github.com/naitsric/orca-claude-procesos",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "procesos",
        "title": "Claude Processes",
        "icon": "activity",
        "entry": "src/panel.tsx",
        "ui": "components"
      },
      {
        "id": "actividad",
        "title": "Claude Activity",
        "icon": "bar-chart-3",
        "entry": "src/graficas.ts",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "revisar",
        "title": "Claude Processes: check now"
      },
      {
        "id": "cerrar-huerfanos",
        "title": "Claude Processes: close certain orphans"
      }
    ],
    "statusBarItems": [
      {
        "id": "resumen",
        "text": "Claude",
        "icon": "bot",
        "tooltip": "Claude Processes",
        "command": "revisar"
      }
    ],
    "settings": [
      {
        "key": "idioma",
        "title": "Language",
        "description": "Language of the panels, the status bar and the notifications. “Same as Orca” follows Orca's interface language, or English if the plugin doesn't have it.",
        "type": "string",
        "default": "auto",
        "enum": [
          "auto",
          "en",
          "es"
        ],
        "enumLabels": [
          "Same as Orca",
          "English",
          "Español"
        ]
      },
      {
        "key": "intervaloSegundos",
        "title": "Check interval (seconds)",
        "description": "How often the worker checks the processes (ps, plus lsof on macOS or /proc on Linux) while the plugin is on.",
        "type": "integer",
        "default": 15,
        "minimum": 5,
        "maximum": 300
      },
      {
        "key": "horasSesionLarga",
        "title": "Hours before a session counts as long",
        "description": "A session open longer than this with no CPU activity is marked for review.",
        "type": "number",
        "default": 12,
        "minimum": 1,
        "maximum": 720
      },
      {
        "key": "avisarHuerfanos",
        "title": "Notify about orphans",
        "description": "A desktop notification the first time a Claude process outlives its session.",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
