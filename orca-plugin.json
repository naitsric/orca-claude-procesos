{
  "manifestVersion": 2,
  "id": "claude-procesos",
  "name": "Procesos de Claude",
  "version": "0.2.0",
  "description": "Monitor de las sesiones de Claude Code, los procesos que lanzan y los que quedaron huérfanos, con el veredicto de cuáles cerrar.",
  "icon": "design/icon-256.png",
  "author": {
    "name": "naitsric",
    "url": "https://github.com/naitsric"
  },
  "repository": "https://github.com/naitsric/orca-claude-procesos",
  "homepage": "https://github.com/naitsric/orca-claude-procesos",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "procesos",
        "title": "Procesos de Claude",
        "icon": "activity",
        "entry": "src/panel.tsx",
        "ui": "components"
      },
      {
        "id": "actividad",
        "title": "Actividad de Claude",
        "icon": "bar-chart-3",
        "entry": "src/graficas.ts",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "revisar",
        "title": "Procesos de Claude: revisar ahora"
      },
      {
        "id": "cerrar-huerfanos",
        "title": "Procesos de Claude: cerrar los huérfanos seguros"
      }
    ],
    "statusBarItems": [
      {
        "id": "resumen",
        "text": "Claude",
        "icon": "bot",
        "tooltip": "Procesos de Claude",
        "command": "revisar"
      }
    ],
    "settings": [
      {
        "key": "intervaloSegundos",
        "title": "Cada cuántos segundos revisar",
        "description": "El worker corre ps y lsof con esta frecuencia mientras el plugin está activo.",
        "type": "integer",
        "default": 15,
        "minimum": 5,
        "maximum": 300
      },
      {
        "key": "horasSesionLarga",
        "title": "Horas para marcar una sesión como larga",
        "description": "Una sesión abierta más tiempo que esto y sin actividad de CPU queda en «revisar».",
        "type": "number",
        "default": 12,
        "minimum": 1,
        "maximum": 720
      },
      {
        "key": "avisarHuerfanos",
        "title": "Avisar cuando aparezcan huérfanos",
        "description": "Notificación de escritorio la primera vez que un proceso de Claude sobrevive a su sesión.",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
